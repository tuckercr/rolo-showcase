{
    "name": "tuckercr/rolo",
    "description": "Project Rolo - custom CRM",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-pdo": "*",
        "nikic/fast-route": "^1.3",
        "phpmailer/phpmailer": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
