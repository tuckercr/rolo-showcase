# Copy to .env and fill in real values. .env is gitignored — never commit actual credentials.

APP_ENV=local
APP_TIMEZONE=America/New_York

# MariaDB (IONOS)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# SFTP (IONOS webspace — used by deploy scripts, not by the app itself)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=

# Google Sign-In (OAuth 2.0) — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm.example.com/auth/google/callback
# Comma-separated allowlist — Google authenticates, this list authorizes
OAUTH_ALLOWED_EMAILS=
# Google Calendar (the debrief's "from your calendar today" suggestions)
# reuses the same OAuth client with no extra keys, but needs two one-time
# things in the GCP console: enable the Google Calendar API, and add
# {APP_URL}/settings/calendar/callback to the client's authorized redirect
# URIs. Each user then connects their own calendar from /settings.

# Long random secret gating public/migrate.php (openssl rand -hex 32). The
# IONOS DB hostname has no public DNS record — it's only reachable from
# inside IONOS's own network — so migrations run via this HTTP endpoint on
# the live server, not from a local machine. Required on the SERVER only;
# leave blank locally unless you're testing against a real local MariaDB.
MIGRATE_TOKEN=

# Daily summary email (9 AM Eastern)
APP_URL=https://crm.example.com
# Shared secret for /cron/daily-summary (also a GitHub Actions secret, CRON_SECRET)
CRON_SECRET=
# Recipients of the morning summary, comma-separated
SUMMARY_RECIPIENTS=
# SMTP (IONOS mailbox). Leave SMTP_HOST empty to fall back to PHP mail()
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# From address shown on the summary email
MAIL_FROM=

# Agent API (docs/API.md) — read-only endpoints for marketing AI agents.
# Leave blank to disable the API entirely. Generate: openssl rand -hex 32
API_TOKEN_READ=
# Future write endpoints (approval-gated); unused by piece 1
API_TOKEN_WRITE=

# Slack bot (docs/SLACK_BOT_SPEC.md) — leave blank to disable entirely.
# Bot token + signing secret from the Slack app (api.slack.com/apps).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Slack member id -> rolo user id; only these people may press bot buttons.
# e.g. U0123ABCD:1,U0456EFGH:2
SLACK_USER_MAP=
# Who gets the evening debrief DM (comma-separated Slack member ids).
SLACK_DEBRIEF_USERS=
# Who gets devops notices: deploys, migrations, failures (comma-separated
# Slack member ids — normally just the person who deploys).
SLACK_OPS_USERS=
