# Copy to .env and fill in real values. .env is gitignored — never commit actual credentials.

APP_ENV=local
APP_TIMEZONE=America/New_York
APP_URL=https://crm.example.com

# MariaDB
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Google Sign-In (OAuth 2.0) — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm.example.com/auth/google/callback
# Comma-separated allowlist — Google authenticates, this list authorizes
OAUTH_ALLOWED_EMAILS=

# Long random secret gating public/migrate.php (openssl rand -hex 32).
# Needed on servers where the DB is only reachable from the host itself.
MIGRATE_TOKEN=

# Daily summary email (9 AM Eastern)
# Shared secret for /cron/daily-summary (also a GitHub Actions secret, CRON_SECRET)
CRON_SECRET=
# Recipients of the morning summary, comma-separated
SUMMARY_RECIPIENTS=
# SMTP mailbox. Leave SMTP_HOST empty to fall back to PHP mail()
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# From address shown on the summary email
MAIL_FROM=

# Agent API + MCP endpoint. Leave blank to disable both entirely.
# Generate each with: openssl rand -hex 32
API_TOKEN_READ=
API_TOKEN_WRITE=
